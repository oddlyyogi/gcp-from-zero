{
  "displayName": "SnapShelf",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {"width": 6, "height": 4, "widget": {"title": "Requests",
        "xyChart": {"dataSets": [{"timeSeriesQuery": {"timeSeriesFilter": {
          "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.labels.service_name=\"snapshelf\"",
          "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE"}}}}]}}},
      {"xPos": 6, "width": 6, "height": 4, "widget": {"title": "Rejected uploads",
        "xyChart": {"dataSets": [{"timeSeriesQuery": {"timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/upload_rejected\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_SUM"}}}}]}}}
    ]
  }
}
